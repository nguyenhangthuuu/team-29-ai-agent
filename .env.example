# Environment Configuration Template for Team 29 (ReBel Agentic Trader)
# Copy this file to .env and configure your keys:
#   cp .env.example .env

# ==============================================================================
# 1. Google Gemini API (Recommended for LLM News Intelligence)
# Get a free key at: https://aistudio.google.com/
# Note: If left blank or commented out, the system automatically runs using
# 100% free, deterministic Loughran-McDonald & contextual NLP fallback ($0.00 cost).
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# 2. OpenAI API (Optional alternative)
# ==============================================================================
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# 3. LangSmith Tracing (Optional - set to true if you have a LangChain key)
# ==============================================================================
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_PROJECT=qdc-fall-2026-rebel
